      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Facade client returns None silently on API failures without a way for callers to distinguish 'not found' from 'error'",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/ffbb_api_client_v2/facade/client.py"
        ],
        "evidence": [
          "Many facade methods return Optional[T] \u2014 on API error (FFBBApiError), they return None, indistinguishable from 'resource not found'",
