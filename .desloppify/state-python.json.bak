    "review::.::holistic::type_safety::filter_sort_list_any": {
      "id": "review::.::holistic::type_safety::filter_sort_list_any",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "MultiSearchQuery.filter and .sort are typed as list[Any] \u2014 no type safety for query predicates",
      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "src/ffbb_api_client_v2/meilisearch/models/multi_search_query.py"
        ],
        "evidence": [
          "filter: list[Any] | None \u2014 Meilisearch filters can be strings, lists, or nested structures",
          "sort: list[Any] | None \u2014 sort expressions are strings like 'nom:asc'",
          "Passing a malformed filter (e.g., a nested dict instead of a filter string) is not caught by the type system"
        ],
        "suggestion": "Define FilterClause = str | list[str | list] as a recursive type alias, or use a Union[str, list[FilterClause]] TypeAlias. At minimum, type sort as list[str] since Meilisearch sort expressions are always strings.",
        "reasoning": "",
        "summary_hash": "2389937b"
      },
      "status": "open",
      "note": null,
      "first_seen": "2026-03-16T20:20:26+00:00",
