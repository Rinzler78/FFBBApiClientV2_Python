    "review::.::holistic::cross_module_architecture::hub_converter_utils": {
      "id": "review::.::holistic::cross_module_architecture::hub_converter_utils",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "converter_utils.py is a god module with 87 importers, creating a large blast radius",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/ffbb_api_client_v2/utils/converter_utils.py"
        ],
        "evidence": [
          "87 model files import from converter_utils.py \u2014 any change to a converter helper (e.g. from_str, from_int) forces re-evaluation across the entire model layer",
          "The module mixes date/time converters, string converters, list converters, enum converters, and UUID converters with no internal grouping"
        ],
        "suggestion": "Split converter_utils.py into focused sub-modules: primitive_converters.py (str/int/float/bool), date_converters.py (datetime/timedelta), collection_converters.py (list/dict), enum_converters.py. Re-export all from converter_utils for backward compat. This bounds blast radius per type of change.",
        "reasoning": "",
        "summary_hash": "fc800e73"
      },
      "status": "open",
      "note": null,
      "first_seen": "2026-03-16T20:20:26+00:00",
